# Runtime
# Maximum AI request body size in MiB (positive integer).
BOS_MAX_REQUEST_BODY_MB=128
BOS_LISTEN=127.0.0.1:8081
BOS_CALLBACK_LISTEN=127.0.0.1:1455
BOS_DATA_FILE=./gateway.enc
BOS_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Optional existing database and Redis services
BOS_DATABASE_DSN=
BOS_JWT_SIGNING_KEY=
BOS_REDIS_URL=

# Required when applying the initial SQL schema. Existing administrators are preserved.
BOS_ADMIN_EMAIL=admin@bosapi.local
BOS_ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-characters

BOS_GEOIP_DB=
BOS_PRIMARY_DOMAIN=https://bosapi.net

# Upstream gateway timeout in seconds (positive integer).
BOS_GATEWAY_TIMEOUT_SECONDS=300

# Login lockout: failures within the rolling window before a temporary lock.
BOS_LOGIN_FAILURE_THRESHOLD=5
BOS_LOGIN_FAILURE_WINDOW_SECONDS=600
BOS_LOGIN_LOCK_SECONDS=900

# Operator-supplied client required for Gemini subscription sign-in and refresh.
BOS_GEMINI_OAUTH_CLIENT_ID=
BOS_GEMINI_OAUTH_CLIENT_SECRET=

# Operator-supplied client required for Antigravity subscription sign-in and refresh.
BOS_ANTIGRAVITY_OAUTH_CLIENT_ID=
BOS_ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Installation telemetry defaults to enabled when no saved choice exists.
# Set the force-disable flag before first startup to prevent initialization and sending.
# The fixed receiver is embedded from backend/internal/gateway/application/usage_reporting.json.
BOS_USAGE_REPORTING_FORCE_DISABLED=false
BOS_USAGE_REPORTING_HTTP_TIMEOUT=5s
