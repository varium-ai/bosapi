{
  "name": "ai-gateway-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-search-metadata.cjs && tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.cjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "preview": "vite preview",
    "preview:ui": "node scripts/preview-ui.mjs",
    "preview:connected": "node scripts/preview-connected.mjs",
    "test:overview": "node --test tests/overview.test.cjs",
    "test:status": "node --test tests/status.test.cjs",
    "test:api": "node --test tests/api-client.test.cjs",
    "test:keys": "node --test tests/keys.test.cjs",
    "test:usage": "node --test tests/usage.test.cjs",
    "test:docs": "node --test tests/docs.test.cjs",
    "test:ux": "node --test tests/ux.test.cjs tests/resource-name.test.cjs",
    "test:templates": "node --test tests/key-templates.test.cjs",
    "test:import": "node --test tests/key-import.test.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@tanstack/react-query": "^5.69.0",
    "antd": "^5.24.4",
    "axios": "^1.18.0",
    "dayjs": "1.11.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "^6.29.0",
    "remark-gfm": "4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.14"
  }
}
