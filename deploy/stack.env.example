# Generate a private copy with ./deploy/stack.sh init. Use hexadecimal passwords.
BOSAPI_PORT=18080
# Optional app binding. --public saves 0.0.0.0 here; the default remains loopback.
# BOSAPI_BIND_IP=127.0.0.1
# This project defaults to host Nginx static delivery. Use go for Go-only delivery.
BOS_WEB_DELIVERY=go
# Prepare this directory before up/start; keep it outside the checkout.
BOS_WEB_ROOT=/var/www/bosapi
MYSQL_DATABASE=bosapi
MYSQL_USER=bosapi
MYSQL_PASSWORD=replace-with-hexadecimal-password
MYSQL_ROOT_PASSWORD=replace-with-another-hexadecimal-password
REDIS_PASSWORD=replace-with-hexadecimal-password
BOS_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
BOS_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
BOS_ADMIN_EMAIL=admin@bosapi.local
BOS_ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-characters
BOS_ALLOWED_UPSTREAM_HOSTS=
# Optional public console address. API addresses are managed in Settings > API Address.
BOS_PRIMARY_DOMAIN=
# Configure this deployment's single API address in Settings > API Address.
TZ=UTC

# Optional build image registry prefix (no https://). The default is DaoCloud.
# BOS_BASE_IMAGE_REGISTRY=docker.m.daocloud.io/library

# Optional absolute host paths. Leave unset to retain the existing named volumes.
# BOS_MYSQL_DATA_MOUNT=/srv/bosapi/mysql
# BOS_REDIS_DATA_MOUNT=/srv/bosapi/redis
# BOS_GATEWAY_DATA_MOUNT=/srv/bosapi/gateway

# Upstream gateway timeout in seconds (positive integer).
BOS_GATEWAY_TIMEOUT_SECONDS=300
# Must exceed the gateway timeout plus 30 seconds for HTTP shutdown and worker cleanup.
BOS_STOP_GRACE_PERIOD=360s

# Ports must be free and distinct from BOSAPI_PORT.
# Expiry retains old containers and blocks the next release; it never kills streams.

# Login lockout: failures within the rolling window before a temporary lock.
BOS_LOGIN_FAILURE_THRESHOLD=5
BOS_LOGIN_FAILURE_WINDOW_SECONDS=600
BOS_LOGIN_LOCK_SECONDS=900

# Gemini CLI / Code Assist subscription sign-in and token refresh.
# Supply an authorized OAuth client for subscription sign-in and token refresh.
# These identify the OAuth application and are not a Gemini API key.
BOS_GEMINI_OAUTH_CLIENT_ID=
BOS_GEMINI_OAUTH_CLIENT_SECRET=
# Supply an authorized Antigravity OAuth client for sign-in and token refresh.
BOS_ANTIGRAVITY_OAUTH_CLIENT_ID=
BOS_ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Installation telemetry defaults to enabled when no saved choice exists.
# Set the force-disable flag before first startup to prevent initialization and sending.
# The fixed receiver is embedded from backend/internal/gateway/application/usage_reporting.json.
BOS_USAGE_REPORTING_FORCE_DISABLED=false
BOS_USAGE_REPORTING_HTTP_TIMEOUT=5s
